{
	"name" : "SecureInclude",
	"version" : "2.1.1",
	"author" : [
		"Noah Spurrier",
		"Matthieu Moy",
		"Edgar Soldin (since v2.0)"
	],
	"url" : "https://www.mediawiki.org/wiki/Extension:SecureInclude",
	"descriptionmsg" : "secureinclude-desc",
	"license-name" : "GPL-3.0-or-later",
	"type" : "parserhook",
	"requires" : {
		"MediaWiki" : ">= 1.25"
	},
	"MessagesDirs" : {
		"SecureInclude" : [
			"i18n"
		]
	},
	"AutoloadClasses" : {
		"SecureInclude" : "SecureInclude.php"
	},
	"Hooks" : {
		"ParserFirstCallInit" : [
			"SecureInclude::onParserFirstCallInit"
		]
	},
	"GroupPermissions" : {
		"secureinclude" : {
			"secureinclude-scripting" : true
		}
	},
	"manifest_version" : 1
}
